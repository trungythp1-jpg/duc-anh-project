rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // User profiles: each account can read its own profile.
    // Admin can read and manage all profiles.
    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId || isAdmin()
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // All business collections remain closed in this bootstrap phase.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}